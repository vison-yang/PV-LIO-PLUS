<launch>
    <arg name="sensor_config" default="$(find pv_lio_plus)/config/avia.yaml"/>
    <arg name="backend" default="voxelmap_plus"/>
    <arg name="observation" default=""/>
    <arg name="rviz" default="true"/>

    <rosparam command="load" file="$(arg sensor_config)"/>
    <rosparam command="load" file="$(find pv_lio_plus)/config/backends/$(arg backend).yaml"/>
    <group if="$(eval arg('observation') not in ['', 'none'])">
        <rosparam command="load" file="$(find pv_lio_plus)/config/observations/$(arg observation).yaml"/>
    </group>
    <param name="mapping/map_type" value="$(arg backend)"/>

    <node pkg="pv_lio_plus" type="pv_lio_plus_node"
          name="pv_lio_plus_node" output="screen"/>
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find pv_lio_plus)/config/rviz_cfg/voxel_mapping.rviz"/>
    </group>
</launch>
